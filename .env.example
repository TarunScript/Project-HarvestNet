# ──────────────────────────────────────────────────────────────
# Project-HarvestNet — Environment Variables
# Copy to .env and fill in real values before running.
# See Section 7.1 of the Engineering Handbook for details.
# ──────────────────────────────────────────────────────────────

# --- Core AI ---
GEMINI_API_KEY=

# --- Google Cloud / Earth Engine ---
GOOGLE_APPLICATION_CREDENTIALS=          # Path to Earth Engine service account JSON

# --- External Data APIs ---
SOILGRIDS_BASE_URL=https://rest.isric.org
OPENWEATHER_API_KEY=

# --- Data Store ---
FIRESTORE_PROJECT_ID=
REDIS_URL=

# --- Operational Thresholds ---
CACHE_FALLBACK_TIMEOUT_MS=1500
OUTBREAK_ALERT_THRESHOLD_COUNT=5
OUTBREAK_ALERT_WINDOW_DAYS=5
DIAGNOSIS_ESCALATION_CONFIDENCE=0.6
